	//! Returns the list of item dictionaries ({:name, :uid, :amiiboId, :size, :icon})
	//! for a given category index. :icon is null when no matching icon exists.
	function getItems(categoryIndex as Number) as Array<Dictionary> {
		return CATEGORY_ITEMS[categoryIndex];
	}
}
